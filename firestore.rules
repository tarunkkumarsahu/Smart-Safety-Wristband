// Sakti Armor — Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules
//
// Security model:
// - users control only their own profile and guardian list
// - alert owners create/update their own alert; owner id is immutable
// - guardians are read-only participants
// - SOS evidence/history cannot be overwritten or deleted by clients

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGuardianOf(userId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(userId)/guardians/$(request.auth.uid)
        );
    }

    function alertOwnerId(alertId) {
      return get(
        /databases/$(database)/documents/alerts/$(alertId)
      ).data.userId;
    }

    function isAlertParticipant(alertId) {
      return signedIn()
        && (
          alertOwnerId(alertId) == request.auth.uid
          || isGuardianOf(alertOwnerId(alertId))
        );
    }

    // User profile: owner only.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Guardian links: managed only by the protected user.
    match /users/{userId}/guardians/{guardianId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // SOS alerts.
    match /alerts/{alertId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isGuardianOf(resource.data.userId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Owner may update their alert, but ownership cannot be reassigned.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // Preserve SOS records from client-side erasure.
      allow delete: if false;
    }

    // Audio metadata/evidence: owner creates, participants read, immutable afterwards.
    match /alerts/{alertId}/audioClips/{clipId} {
      allow read: if isAlertParticipant(alertId);
      allow create: if signedIn()
        && alertOwnerId(alertId) == request.auth.uid;
      allow update, delete: if false;
    }

    // Location history: owner appends, participants read, immutable afterwards.
    match /alerts/{alertId}/locationHistory/{docId} {
      allow read: if isAlertParticipant(alertId);
      allow create: if signedIn()
        && alertOwnerId(alertId) == request.auth.uid;
      allow update, delete: if false;
    }

    // Messages: participants may append and read; messages are immutable from clients.
    match /alerts/{alertId}/messages/{docId} {
      allow read: if isAlertParticipant(alertId);
      allow create: if isAlertParticipant(alertId);
      allow update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
