// Sakti Armor — Firebase Storage Security Rules
// Deploy with: firebase deploy --only storage
//
// emergency_audio/{alertId}/{filename}
// - alert owner may upload audio evidence
// - alert owner and explicitly linked guardians may read it
// - audio evidence is immutable from the client

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function alertOwnerId(alertId) {
      return firestore.get(
        /databases/(default)/documents/alerts/$(alertId)
      ).data.userId;
    }

    function isAlertParticipant(alertId) {
      return signedIn()
        && (
          alertOwnerId(alertId) == request.auth.uid
          || firestore.exists(
            /databases/(default)/documents/users/$(alertOwnerId(alertId))/guardians/$(request.auth.uid)
          )
        );
    }

    match /emergency_audio/{alertId}/{filename} {
      allow read: if isAlertParticipant(alertId);

      allow create: if signedIn()
        && alertOwnerId(alertId) == request.auth.uid
        && request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      // SOS evidence must not be overwritten or erased by clients.
      allow update, delete: if false;
    }

    // Deny every other Storage path by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
